{
  "name": "express-boilerplate",
  "version": "9.1.4",
  "private": true,
  "type": "module",
  "description": "Production-grade Express 5 API boilerplate",
  "license": "UNLICENSED",
  "author": {
    "name": "Mahaverick",
    "email": "support@mahaverick.com"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --import ./src/observability/tracing.ts src/index.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json --resolve-full-paths && cp -r src/database/migrations dist/database/ && cp -r src/data dist/",
    "start": "node --env-file-if-exists=.env --import ./dist/observability/tracing.js dist/index.js",
    "lint": "vp check && eslint . --max-warnings 0 && tsc --noEmit",
    "lint:fix": "vp check --fix && eslint . --fix",
    "typecheck": "tsc --noEmit",
    "lint:docs": "node scripts/lint-docs.mjs",
    "knip": "knip",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "env:example": "tsx src/scripts/generate-env-example.ts",
    "env:table": "tsx src/scripts/generate-env-example.ts --table",
    "db:migration:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "platform:grant": "tsx --env-file-if-exists=.env src/scripts/platform-grant.ts",
    "email:fire-event": "tsx --env-file-if-exists=.env src/scripts/email-fire-event.ts",
    "onboarding:reconcile": "tsx --env-file-if-exists=.env src/scripts/onboarding-reconcile.ts",
    "analytics:backfill-groups": "tsx --env-file-if-exists=.env src/scripts/analytics-backfill-groups.ts",
    "flags:sync": "tsx --env-file-if-exists=.env src/scripts/flags-sync.ts",
    "billing:seed": "tsx --env-file-if-exists=.env src/scripts/billing-seed.ts",
    "billing:time-travel": "tsx --env-file-if-exists=.env src/scripts/billing-time-travel.ts",
    "test": "vp test run",
    "test:unit": "vp test run --project unit",
    "test:integration": "vp test run --project integration",
    "scrub:gate": "tsx tests/helpers/scrub-gate.ts",
    "test:watch": "vp test watch",
    "test:coverage": "vp test run --coverage",
    "commit": "cz",
    "prepare": "vp config --hooks --no-agent || echo 'vp config failed: git hooks are not installed. Run pnpm prepare.' >&2; node -e 'try{if(require(\"node:child_process\").execFileSync(\"git\",[\"config\",\"core.hooksPath\"],{encoding:\"utf8\",stdio:[\"ignore\",\"pipe\",\"ignore\"]}).trim()===\".husky/_\")console.warn(\"Git hooks still point at .husky/_, so no hook runs. Run: git config --unset core.hooksPath && pnpm prepare\")}catch{}'",
    "gate": "sh scripts/pre-push-gate.sh",
    "push": "sh scripts/push.sh"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-pino": "0.68.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@posthog/core": "1.55.3",
    "@simplewebauthn/server": "14.0.3",
    "bullmq": "^6.3.8",
    "connect-redis": "^10.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "fflate": "0.8.3",
    "helmet": "8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "nodemailer": "^10.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pdfkit": "0.20.2",
    "pino": "10.3.1",
    "postgres": "^3.4.9",
    "rate-limit-redis": "^6.0.1",
    "redis": "6.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/cz-commitlint": "^21.2.3",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/pdfkit": "0.17.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "commitizen": "^4.3.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "65.1.0",
    "eslint-plugin-sonarjs": "4.2.1",
    "eslint-plugin-unicorn": "76.0.0",
    "knip": "6.39.0",
    "pino-pretty": "13.1.3",
    "supertest": "7.3.0",
    "tsc-alias": "^1.9.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.1",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
