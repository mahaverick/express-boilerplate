{
  "name": "express-boilerplate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production-grade Express 5 API boilerplate",
  "license": "UNLICENSED",
  "author": {
    "name": "Mahaverick",
    "email": "support@mahaverick.com"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "tsx watch --import ./src/observability/tracing.ts src/index.ts",
    "build": "rm -rf dist && tsc && tsc-alias --resolve-full-paths && cp -r src/database/migrations dist/database/",
    "start": "node --import ./dist/observability/tracing.js dist/index.js",
    "lint": "eslint . && tsc -p tsconfig.typecheck.json --noEmit",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:example": "tsx src/scripts/generate-env-example.ts",
    "db:migration:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "commit": "cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-winston": "^0.66.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.6",
    "connect-redis": "^10.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "nodemailer": "^10.0.9",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "postgres": "^3.4.9",
    "rate-limit-redis": "^6.0.1",
    "redis": "6.2.1",
    "winston": "^3.19.0",
    "winston-transport": "^4.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/cz-commitlint": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.1.1",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "commitizen": "^4.3.2",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsdoc": "64.4.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsc-alias": "^1.9.0",
    "tsx": "4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "tests/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{json,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
