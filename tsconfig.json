{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": { "@/*": ["./src/*"] },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": false,
    "noEmitOnError": true
  },
  "include": ["src/**/*"],
  // src/lint-fixtures/** is a deliberately-circular pair of modules that
  // exists only so tests/unit/lint-gates.test.ts can prove import-x/no-cycle
  // fires on an ALIASED ("@/") import. It must sit under src/ because
  // tsconfig's paths map "@/*" to "./src/*" only — so it is excluded here
  // instead, and never reaches dist/.
  "exclude": ["node_modules", "dist", "**/*.test.ts", "src/lint-fixtures/**"]
}
